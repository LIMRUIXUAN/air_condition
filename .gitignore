.env
.env.local
.env.*.local
config.js

# OS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node & Package Manager Artifacts (if used in future)
node_modules/
npm-cache/
.pnp
.pnp.js

# Build & Cache Folders
dist/
build/
.cache/
.temp/
tmp/

# IDE & Editor Configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
