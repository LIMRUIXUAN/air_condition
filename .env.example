# ==============================================================================
# AERO-NEXUS Atmospheric Map | Environment Variables Template
# Copy this file to .env and insert your real keys
# ==============================================================================

# CARTO Basemaps API Key
# Get your key at: https://carto.com/basemaps/apikey/
# Enables authenticated high-speed Carto Dark Matter raster & vector tiles
CARTO_API_KEY=

# WAQI (World Air Quality Index / aqicn.org) API Token (Optional)
# Get a free token at: https://aqicn.org/data-platform/token/
WAQI_API_KEY=

# OpenWeatherMap API Key (Optional)
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=
